{
  "name": "@memef1f1y/dsh-plugin-tts",
  "description": "DSH 消息朗读插件：7 种 TTS 后端（Edge / Google Cloud / RVC / Index-TTS2 / Breeze TTS 2 / CosyVoice / GPT-SoVITS），自动朗读、选区朗读、长文分块无缝播放、本机服务启动与模型扫描",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "tts",
    "text-to-speech",
    "edge-tts",
    "rvc",
    "index-tts2",
    "breeze-tts2",
    "cosyvoice",
    "gpt-sovits",
    "voice-clone",
    "google-cloud-tts"
  ],
  "version": "0.11.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "rvc-server.py",
    "cordis.patch.yml",
    "docs/USER-GUIDE.md",
    "docs/RVC-GUIDE.md",
    "docs/EDGE-GUIDE.md",
    "docs/CLOUD-GUIDE.md",
    "docs/COSYVOICE-GUIDE.md",
    "docs/INDEX-TTS2-GUIDE.md",
    "docs/GPT-SOVITS-GUIDE.md",
    "docs/BREEZE-GUIDE.md",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-web": ">=0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-base": "0.2.0-rc.2"
  },
  "scripts": {
    "test": "node tests/smoke.mjs",
    "test:live": "node tests/rvc-server-live.mjs",
    "test:patch": "node tests/package-runtime-patch.mjs",
    "test:i18n": "node tests/i18n-keys.mjs",
    "test:client": "node tests/client-load.mjs",
    "test:archive": "node tests/archive-guard.mjs",
    "test:gsv": "node tests/gpt-sovits-contract.mjs",
    "test:voices": "node tests/voices-dir.mjs",
    "test:gsv-e2e": "node tests/e2e-gpt-sovits.mjs",
    "test:pack": "node tests/pack-guard.mjs",
    "test:privacy": "node tests/privacy-guard.mjs",
    "test:disc": "node tests/discovery.mjs",
    "test:slots": "node tests/bundle-slot.mjs",
    "test:audio": "node tests/audio-release.mjs",
    "test:all": "node tests/smoke.mjs && node tests/rvc-server-live.mjs && node tests/package-runtime-patch.mjs && node tests/i18n-keys.mjs && node tests/client-load.mjs && node tests/archive-guard.mjs && node tests/gpt-sovits-contract.mjs && node tests/breeze-contract.mjs && node tests/voice-pairs.mjs && node tests/gsv-library.mjs && node tests/voices-dir.mjs && node tests/discovery.mjs && node tests/e2e-gpt-sovits.mjs && node tests/pack-guard.mjs && node tests/privacy-guard.mjs && node tests/bundle-slot.mjs && node tests/audio-release.mjs",
    "test:lib": "node tests/gsv-library.mjs",
    "test:breeze": "node tests/breeze-contract.mjs",
    "test:voice-pairs": "node tests/voice-pairs.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1624318455/dsh-plugin-tts.git"
  },
  "license": "MIT"
}
